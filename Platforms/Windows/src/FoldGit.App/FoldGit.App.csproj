<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en</DefaultLanguage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Never</AppxBundle>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FoldGitCloudDebug)' == 'true' and '$(Configuration)' == 'Debug'">
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);FOLDGIT_CLOUD_DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FoldGitCloudDebug)' == 'true' and '$(FoldGitCloudCompatibility)' == 'true' and '$(Configuration)' == 'Debug'">
    <TargetPlatformMinVersion>10.0.20348.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <Target Name="RejectReleaseCloudCompatibility" BeforeTargets="PrepareForBuild" Condition="'$(FoldGitCloudDebug)' == 'true' and '$(Configuration)' != 'Debug'">
    <Error Text="FoldGitCloudDebug is restricted to Debug builds. Release requires Windows 11 24H2." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../FoldGit.Core/FoldGit.Core.csproj" />
    <ProjectReference Include="../FoldGit.Platform.Windows/FoldGit.Platform.Windows.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <Content Include="../../../../Shared/Resources/FileIcons/MaterialFileIcons/**/*" Link="Assets/FileIcons/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../Shared/Resources/FileIcons/MaterialFileIcons.json" Link="Assets/MaterialFileIcons.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../Shared/Resources/Licenses/LICENSE.txt" Link="Assets/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(WindowsPackageType)' == 'MSIX'" />
  </ItemGroup>
  <ItemGroup>
    <WindowsIconsInput Include="../../../../Shared/Resources/Branding/Images/FoldGit.webp;../../../../Scripts/generate-windows-icons.py;../../../../Scripts/build-requirements.txt" />
    <ManifestLocalizationsInput Include="../../../../Shared/Resources/Localization/*.json;../../../../Scripts/generate-resources.py" />
    <UpToDateCheckInput Include="@(WindowsIconsInput);@(ManifestLocalizationsInput)" />
  </ItemGroup>
  <!-- The generators only rewrite changed files, so a stamp file records the last successful run.
       When a target is skipped as up to date, MSBuild still evaluates its PropertyGroup and ItemGroup. -->
  <Target Name="GenerateWindowsIcons" BeforeTargets="AssignTargetPaths"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(WindowsIconsInput)" Outputs="$(IntermediateOutputPath)WindowsIcons.stamp">
    <PropertyGroup>
      <WindowsIconsDirectory>$(IntermediateOutputPath)WindowsIcons</WindowsIconsDirectory>
      <ApplicationIcon>$(WindowsIconsDirectory)\FoldGit.ico</ApplicationIcon>
    </PropertyGroup>
    <Exec Command="python -c &quot;import PIL&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="WindowsIconsPythonExitCode" />
    </Exec>
    <Error Condition="'$(WindowsIconsPythonExitCode)' != '0'"
           Text="Generating Windows icons requires Python 3 on PATH with Pillow. Run: python -m pip install -r Scripts/build-requirements.txt" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\..\..\Scripts\generate-windows-icons.py&quot; &quot;$(WindowsIconsDirectory)&quot;" />
    <Touch Files="$(IntermediateOutputPath)WindowsIcons.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <GeneratedWindowsIcon Include="$(WindowsIconsDirectory)\*.png;$(WindowsIconsDirectory)\*.ico" />
      <Content Include="@(GeneratedWindowsIcon)"
               Link="Assets\%(GeneratedWindowsIcon.Filename)%(GeneratedWindowsIcon.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="@(GeneratedWindowsIcon)" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateManifestLocalizations" BeforeTargets="BeforeGenerateProjectPriFile"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(ManifestLocalizationsInput)" Outputs="$(IntermediateOutputPath)ManifestLocalizations.stamp">
    <Exec Command="python --version" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="ManifestLocalizationsPythonExitCode" />
    </Exec>
    <Error Condition="'$(ManifestLocalizationsPythonExitCode)' != '0'"
           Text="Generating manifest localizations requires Python 3 on PATH. Install Python 3, then run: python -m pip install -r Scripts/build-requirements.txt" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\..\..\Scripts\generate-resources.py&quot; windows &quot;$(IntermediateOutputPath)ManifestLocalizations&quot;" />
    <Touch Files="$(IntermediateOutputPath)ManifestLocalizations.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <ManifestLocalization Include="$(IntermediateOutputPath)ManifestLocalizations\**\Resources.resw" />
      <PRIResource Include="@(ManifestLocalization)"
                   Link="Strings\%(ManifestLocalization.RecursiveDir)%(ManifestLocalization.Filename)%(ManifestLocalization.Extension)" />
      <FileWrites Include="@(ManifestLocalization)" />
    </ItemGroup>
  </Target>
</Project>
