"The worktree is locked, missing, or its branch is still checked out. Keep it or unlock it before cleanup." = "工作树已锁定、目录缺失，或分支仍被检出。请保留它，或解锁后再清理。";
"The target branch does not contain all source commits. The worktree and branch were kept." = "目标分支尚未包含全部源提交。工作树和分支已保留。";
"Finish the existing merge, rebase, or cherry-pick before starting another merge." = "请先完成当前合并、变基或拣选操作，再开始新的合并。";
"Commit or stash changes in %@ before merging." = "请先提交或贮藏 %@ 中的修改，再进行合并。";

"Worktrees" = "工作树";

/* Worktree enablement */
"Enable Worktrees" = "启用工作树";
"Repository Worktrees" = "各仓库工作树";
"After enabling worktrees globally, enable them for each repository in its context menu. Worktree information and management actions appear only for enabled repositories. Turning this off preserves repository choices." = "全局启用后，通过仓库右键菜单为各仓库启用工作树。只有启用的仓库才显示工作树信息和管理操作。关闭此开关会保留各仓库的选择。";

"Search Author, Email, or Message" = "搜索作者、邮箱或提交信息";

/* File change types in diff headers. */
"Added" = "新增";
"Modified" = "修改";
"Deleted" = "删除";
"Renamed" = "重命名";
"Copied" = "复制";
"File Mode Changed" = "文件权限变化";
"Conflicted" = "冲突";
"Binary File" = "二进制文件";
"Similarity: %@" = "相似度：%@";
"File Mode: %@ → %@" = "文件权限：%@ → %@";
